# Copy to .env.local and fill in real values. Never commit real secrets.

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon Storage (S3 compatible) — product & category images
AWS_ENDPOINT_URL_S3=https://your-branch.storage.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=book-store-images

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk user id that is allowed into /admin
ADMIN_USER_ID=user_xxx

# Public canonical URL (QiCard callbacks must reach it over HTTPS)
WEBSITE_URL=http://localhost:3000

# QiCard payment gateway (falls back to the public UAT sandbox when empty)
QICARD_BASE_URL=
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_TERMINAL_ID=
QICARD_PUBLIC_KEY=
