# Public URL of this app. QiCard callbacks must reach it over HTTPS.

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
ADMIN_USER_ID=your_clerk_user_id

# Neon PostgreSQL (pooled runtime URL and direct CLI URL)
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/db?sslmode=require
DIRECT_URL=postgresql://user:password@your-neon-host/db?sslmode=require

# Neon Object Storage (run `neon env pull` to populate AWS_* values)
NEON_STORAGE_BUCKET=book-store-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

WEBSITE_URL=http://localhost:3000

# QiCard payment gateway
QICARD_BASE_URL=https://uat-sandbox-3ds-api.qi.iq/api/v1
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_TERMINAL_ID=
QICARD_PUBLIC_KEY=
